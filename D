using System;
using System.Windows.Forms;

namespace DvizhenieFigur
{
    internal static class Program
    {
        [STAThread]
        static void Main()
        {
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);
            
            // Показываем заставку
            FormZastavka zastavka = new FormZastavka();
            zastavka.Show();
            zastavka.Refresh();
            System.Threading.Thread.Sleep(2000); // Заставка видна 2 секунды
            
            // Запускаем главную форму
            Application.Run(new FormMove());
        }
    }
}

using System;
using System.Windows.Forms;

namespace DvizhenieFigur
{
    public partial class FormMove : Form
    {
        public FormMove()
        {
            InitializeComponent();
        }

        // Кнопка "Пуск" - запускает движение картинки
        private void bt_Pusk_Click(object sender, EventArgs e)
        {
            timer1.Enabled = true;
            timer1.Interval = 10;
        }

        // Кнопка "Стоп" - останавливает движение картинки
        private void bt_Stop_Click(object sender, EventArgs e)
        {
            timer1.Enabled = false;
        }

        // Таймер для движения картинки
        private void timer1_Tick(object sender, EventArgs e)
        {
            // Если картинка доходит до правого края - возвращаем в начало
            if (image1.Left >= this.ClientSize.Width - image1.Width)
            {
                image1.Left = 16;
            }
            else
            {
                image1.Left = image1.Left + 1;
            }
        }

        // Кнопка "Двигатель кругов" - запускает движение кругов
        private void bt_MoveCircle_Click(object sender, EventArgs e)
        {
            timer2.Interval = 10;
            timer2.Enabled = true;
        }

        // Кнопка "Остановить круги" - останавливает движение кругов
        private void bt_StopCircle_Click(object sender, EventArgs e)
        {
            timer2.Enabled = false;
        }

        // Кнопка "Восстановить круги" - возвращает круги в центр
        private void bt_VosstCircle_Click(object sender, EventArgs e)
        {
            // Начальные координаты для всех кругов (центр формы)
            shape1.Left = 184;
            shape2.Top = 112;
            shape3.Left = 184;
            shape4.Top = 112;
            shape5.Left = 184;
            shape5.Top = 112;
            shape6.Left = 184;
            shape6.Top = 112;
            shape7.Left = 184;
            shape7.Top = 112;
            shape8.Left = 184;
            shape8.Top = 112;
        }

        // Таймер для движения кругов
        private void timer2_Tick(object sender, EventArgs e)
        {
            // Четыре круга двигаются к углам (меняется один параметр)
            shape1.Left = shape1.Left + 1;        // вправо
            shape2.Top = shape2.Top + 1;          // вниз
            shape3.Left = shape3.Left - 1;        // влево
            shape4.Top = shape4.Top - 1;          // вверх

            // Остальные круги двигаются по диагонали
            shape5.Left = shape5.Left + 1;        // вправо-вниз
            shape5.Top = shape5.Top + 1;
            shape6.Left = shape6.Left - 1;        // влево-вниз
            shape6.Top = shape6.Top + 1;
            shape7.Left = shape7.Left - 1;        // влево-вверх
            shape7.Top = shape7.Top - 1;
            shape8.Left = shape8.Left + 1;        // вправо-вверх
            shape8.Top = shape8.Top - 1;
        }
    }
}


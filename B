using System;
using System.Collections.Generic;
using System.Drawing;
using System.IO;
using System.Windows.Forms;

namespace PictureGalleryV2
{
    public partial class Form1 : Form
    {
        // Переменные для слайд-шоу
        private List<string> currentAlbum = new List<string>();
        private int currentPos = -1;

        public Form1()
        {
            InitializeComponent();

            // Настраиваем список альбомов
            cboAlbum.Items.Add("Летние фото");
            cboAlbum.Items.Add("Зимние фото");
            cboAlbum.Items.Add("Городские фото");
            cboAlbum.SelectedIndex = 0;
            LoadAlbum(cboAlbum.SelectedItem.ToString());

            // Подписываем события
            btnSelect.Click += BtnSelect_Click;
            btnClear.Click += BtnClear_Click;
            btnAddToCollection.Click += BtnAddToCollection_Click;
            lstCollection.SelectedIndexChanged += LstCollection_SelectedIndexChanged;
            cboAlbum.SelectedIndexChanged += CboAlbum_SelectedIndexChanged;
            btnBack.Click += BtnBack_Click;
            btnForward.Click += BtnForward_Click;
            picLeft.Click += PicLeft_Click;
            picRight.Click += PicRight_Click;
            this.FormClosing += Form1_FormClosing;
        }

        // ========== ВКЛАДКА 1: ГАЛЕРЕЯ ==========
        private void BtnSelect_Click(object sender, EventArgs e)
        {
            using (OpenFileDialog dlg = new OpenFileDialog())
            {
                dlg.Filter = "Картинки|*.jpg;*.jpeg;*.png;*.bmp;*.gif";
                dlg.Title = "Выберите изображение";
                if (dlg.ShowDialog() == DialogResult.OK)
                {
                    txtFilePath.Text = dlg.FileName;
                    picImage.Image?.Dispose();
                    picImage.Image = Image.FromFile(dlg.FileName);
                }
            }
        }

        private void BtnClear_Click(object sender, EventArgs e)
        {
            if (picImage.Image != null)
            {
                picImage.Image.Dispose();
                picImage.Image = null;
            }
            txtFilePath.Text = "";
        }

        // ========== ВКЛАДКА 2: КОЛЛЕКЦИЯ ==========
        private void BtnAddToCollection_Click(object sender, EventArgs e)
        {
            string folder = Path.Combine(Application.StartupPath, "my_collection");
            if (!Directory.Exists(folder))
                Directory.CreateDirectory(folder);

            using (OpenFileDialog dlg = new OpenFileDialog())
            {
                dlg.Filter = "Картинки|*.jpg;*.jpeg;*.png;*.bmp;*.gif";
                dlg.Title = "Выберите картинку для коллекции";
                if (dlg.ShowDialog() == DialogResult.OK)
                {
                    string name = Path.GetFileName(dlg.FileName);
                    string dest = Path.Combine(folder, name);
                    if (!File.Exists(dest))
                        File.Copy(dlg.FileName, dest);
                    if (!lstCollection.Items.Contains(name))
                        lstCollection.Items.Add(name);
                }
            }
        }

        private void LstCollection_SelectedIndexChanged(object sender, EventArgs e)
        {
            if (lstCollection.SelectedItem != null)
            {
                string name = lstCollection.SelectedItem.ToString();
                string path = Path.Combine(Application.StartupPath, "my_collection", name);
                if (File.Exists(path))
                {
                    picPreview.Image?.Dispose();
                    picPreview.Image = Image.FromFile(path);
                }
            }
        }

        // ========== ВКЛАДКА 3: СЛАЙД-ШОУ ==========
        private void CboAlbum_SelectedIndexChanged(object sender, EventArgs e)
        {
            LoadAlbum(cboAlbum.SelectedItem.ToString());
        }

        private void LoadAlbum(string albumName)
        {
            string folder = "";
            if (albumName == "Летние фото") folder = "album_summer";
            else if (albumName == "Зимние фото") folder = "album_winter";
            else if (albumName == "Городские фото") folder = "album_city";

            string fullPath = Path.Combine(Application.StartupPath, folder);
            if (Directory.Exists(fullPath))
            {
                currentAlbum.Clear();
                string[] exts = { "*.jpg", "*.jpeg", "*.png", "*.bmp", "*.gif" };
                foreach (string ext in exts)
                {
                    currentAlbum.AddRange(Directory.GetFiles(fullPath, ext));
                }
                if (currentAlbum.Count > 0)
                {
                    currentPos = 0;
                    ShowPicture(currentPos);
                }
                else
                {
                    currentPos = -1;
                    picMain.Image = null;
                    picLeft.Image = null;
                    picRight.Image = null;
                }
            }
            else
            {
                MessageBox.Show("Папка не найдена: " + fullPath);
            }
        }

        private void ShowPicture(int index)
        {
            if (index < 0 || index >= currentAlbum.Count) return;

            // Основное фото
            picMain.Image?.Dispose();
            picMain.Image = Image.FromFile(currentAlbum[index]);

            // Левое (предыдущее)
            int leftIdx = index - 1;
            if (leftIdx >= 0)
            {
                picLeft.Image?.Dispose();
                picLeft.Image = Image.FromFile(currentAlbum[leftIdx]);
                picLeft.Visible = true;
            }
            else
            {
                picLeft.Image = null;
                picLeft.Visible = false;
            }

            // Правое (следующее)
            int rightIdx = index + 1;
            if (rightIdx < currentAlbum.Count)
            {
                picRight.Image?.Dispose();
                picRight.Image = Image.FromFile(currentAlbum[rightIdx]);
                picRight.Visible = true;
            }
            else
            {
                picRight.Image = null;
                picRight.Visible = false;
            }
        }

        private void BtnBack_Click(object sender, EventArgs e)
        {
            if (currentPos > 0)
            {
                currentPos--;
                ShowPicture(currentPos);
            }
        }

        private void BtnForward_Click(object sender, EventArgs e)
        {
            if (currentPos < currentAlbum.Count - 1)
            {
                currentPos++;
                ShowPicture(currentPos);
            }
        }

        private void PicLeft_Click(object sender, EventArgs e)
        {
            if (currentPos > 0)
            {
                currentPos--;
                ShowPicture(currentPos);
            }
        }

        private void PicRight_Click(object sender, EventArgs e)
        {
            if (currentPos < currentAlbum.Count - 1)
            {
                currentPos++;
                ShowPicture(currentPos);
            }
        }

        // Освобождение ресурсов
        private void Form1_FormClosing(object sender, FormClosingEventArgs e)
        {
            picImage.Image?.Dispose();
            picPreview.Image?.Dispose();
            picMain.Image?.Dispose();
            picLeft.Image?.Dispose();
            picRight.Image?.Dispose();
        }
    }
}

using System;
using System.Windows.Forms;

namespace SpaceMove
{
    public partial class FormMove : Form
    {
        private int step = 1; // 1 - вправо, -1 - влево

        public FormMove()
        {
            InitializeComponent();
        }

        // Кнопка "Пуск" для картинки
        private void btStart_Click(object sender, EventArgs e)
        {
            timerImg.Enabled = true;
        }

        // Кнопка "Стоп" для картинки
        private void btStop_Click(object sender, EventArgs e)
        {
            timerImg.Enabled = false;
        }

        // Таймер для движения картинки
        private void timerImg_Tick(object sender, EventArgs e)
        {
            // Отскок от левого края
            if (pictureBox1.Left <= 0)
                step = 1;
            // Отскок от правого края
            if (pictureBox1.Right >= this.ClientSize.Width)
                step = -1;
            
            pictureBox1.Left += step;
        }

        // Кнопка "Двигатель кругов"
        private void btStartCircles_Click(object sender, EventArgs e)
        {
            timerCircles.Enabled = true;
        }

        // Кнопка "Остановить круги"
        private void btStopCircles_Click(object sender, EventArgs e)
        {
            timerCircles.Enabled = false;
        }

        // Кнопка "Восстановить круги"
        private void btReset_Click(object sender, EventArgs e)
        {
            // Возвращаем все кнопки в центр панели (координаты 0,0 внутри Panel)
            btnRed.Left = 0;
            btnRed.Top = 0;
            btnGreen.Left = 0;
            btnGreen.Top = 0;
            btnBlue.Left = 0;
            btnBlue.Top = 0;
            btnYellow.Left = 0;
            btnYellow.Top = 0;
            btnPurple.Left = 0;
            btnPurple.Top = 0;
            btnCyan.Left = 0;
            btnCyan.Top = 0;
        }

        // Таймер для движения кругов
        private void timerCircles_Tick(object sender, EventArgs e)
        {
            // Красный — вправо
            if (btnRed.Left < panel1.Width - btnRed.Width)
                btnRed.Left += 2;

            // Зелёный — вниз
            if (btnGreen.Top < panel1.Height - btnGreen.Height)
                btnGreen.Top += 2;

            // Синий — влево
            if (btnBlue.Left > 0)
                btnBlue.Left -= 2;

            // Жёлтый — вверх
            if (btnYellow.Top > 0)
                btnYellow.Top -= 2;

            // Фиолетовый — вправо-вниз (диагональ)
            if (btnPurple.Left < panel1.Width - btnPurple.Width && 
                btnPurple.Top < panel1.Height - btnPurple.Height)
            {
                btnPurple.Left += 1;
                btnPurple.Top += 1;
            }

            // Голубой — влево-вверх (диагональ)
            if (btnCyan.Left > 0 && btnCyan.Top > 0)
            {
                btnCyan.Left -= 1;
                btnCyan.Top -= 1;
            }
        }
    }
}


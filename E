using System;
using System.Windows.Forms;
using System.Threading;

namespace SpaceMove
{
    internal static class Program
    {
        [STAThread]
        static void Main()
        {
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);

            // Показываем заставку
            FormSplash splash = new FormSplash();
            splash.Show();
            splash.Refresh();
            
            // Заставка видна 2 секунды (2000 мс)
            Thread.Sleep(2000);
            
            // Закрываем заставку и запускаем главную форму
            splash.Close();
            splash.Dispose();
            
            Application.Run(new FormMove());
        }
    }
}


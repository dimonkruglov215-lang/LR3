using System;
using System.Collections.Generic;
using System.Drawing;
using System.IO;
using System.Windows.Forms;

namespace PictureGallery
{
    public partial class Form1 : Form
    {
        // Для задания 3
        private List<string> currentPhotos = new List<string>(); // пути к фото текущей галереи
        private int currentIndex = -1; // индекс текущего фото

        public Form1()
        {
            InitializeComponent();

            // Заполняем ComboBox названиями галерей
            comboBoxGallery.Items.Add("Летний отдых");
            comboBoxGallery.Items.Add("Зимний пейзаж");
            comboBoxGallery.Items.Add("Городские зарисовки");
            comboBoxGallery.SelectedIndex = 0;
            LoadGalleryPhotos(comboBoxGallery.SelectedItem.ToString());

            // Подписываем события
            buttonOpen.Click += ButtonOpen_Click;
            buttonClose.Click += ButtonClose_Click;
            buttonAdd.Click += ButtonAdd_Click;
            listBoxImages.SelectedIndexChanged += ListBoxImages_SelectedIndexChanged;
            comboBoxGallery.SelectedIndexChanged += ComboBoxGallery_SelectedIndexChanged;
            buttonPrev.Click += ButtonPrev_Click;
            buttonNext.Click += ButtonNext_Click;
            pictureBoxPrev.Click += PictureBoxPrev_Click;
            pictureBoxNext.Click += PictureBoxNext_Click;
            this.FormClosing += Form1_FormClosing;
        }

        // ========== ЗАДАНИЕ 1 ==========
        private void ButtonOpen_Click(object sender, EventArgs e)
        {
            using (OpenFileDialog dlg = new OpenFileDialog())
            {
                dlg.Filter = "Изображения|*.jpg;*.jpeg;*.png;*.bmp;*.gif|Все файлы|*.*";
                dlg.Title = "Выберите изображение";
                if (dlg.ShowDialog() == DialogResult.OK)
                {
                    textBoxPath.Text = dlg.FileName;
                    pictureBox1.Image?.Dispose();
                    pictureBox1.Image = Image.FromFile(dlg.FileName);
                    pictureBox1.SizeMode = PictureBoxSizeMode.Zoom;
                }
            }
        }

        private void ButtonClose_Click(object sender, EventArgs e)
        {
            if (pictureBox1.Image != null)
            {
                pictureBox1.Image.Dispose();
                pictureBox1.Image = null;
            }
            textBoxPath.Text = "";
        }

        // ========== ЗАДАНИЕ 2 ==========
        private void ButtonAdd_Click(object sender, EventArgs e)
        {
            string folder = Path.Combine(Application.StartupPath, "изображения");
            if (!Directory.Exists(folder))
                Directory.CreateDirectory(folder);

            using (OpenFileDialog dlg = new OpenFileDialog())
            {
                dlg.Filter = "Изображения|*.jpg;*.jpeg;*.png;*.bmp;*.gif";
                dlg.Title = "Выберите изображение для добавления в список";
                if (dlg.ShowDialog() == DialogResult.OK)
                {
                    string fileName = Path.GetFileName(dlg.FileName);
                    string destPath = Path.Combine(folder, fileName);
                    if (!File.Exists(destPath))
                        File.Copy(dlg.FileName, destPath);
                    if (!listBoxImages.Items.Contains(fileName))
                        listBoxImages.Items.Add(fileName);
                }
            }
        }

        private void ListBoxImages_SelectedIndexChanged(object sender, EventArgs e)
        {
            if (listBoxImages.SelectedItem != null)
            {
                string fileName = listBoxImages.SelectedItem.ToString();
                string path = Path.Combine(Application.StartupPath, "изображения", fileName);
                if (File.Exists(path))
                {
                    pictureBox2.Image?.Dispose();
                    pictureBox2.Image = Image.FromFile(path);
                    pictureBox2.SizeMode = PictureBoxSizeMode.Zoom;
                }
            }
        }

        // ========== ЗАДАНИЕ 3 ==========
        private void ComboBoxGallery_SelectedIndexChanged(object sender, EventArgs e)
        {
            LoadGalleryPhotos(comboBoxGallery.SelectedItem.ToString());
        }

        private void LoadGalleryPhotos(string galleryName)
        {
            string folderName = "";
            if (galleryName == "Летний отдых") folderName = "галерея1";
            else if (galleryName == "Зимний пейзаж") folderName = "галерея2";
            else if (galleryName == "Городские зарисовки") folderName = "галерея3";

            string path = Path.Combine(Application.StartupPath, folderName);
            if (Directory.Exists(path))
            {
                currentPhotos.Clear();
                string[] extensions = { "*.jpg", "*.jpeg", "*.png", "*.bmp", "*.gif" };
                foreach (string ext in extensions)
                {
                    currentPhotos.AddRange(Directory.GetFiles(path, ext));
                }
                if (currentPhotos.Count > 0)
                {
                    currentIndex = 0;
                    ShowPhoto(currentIndex);
                }
                else
                {
                    currentIndex = -1;
                    pictureBoxMain.Image = null;
                    pictureBoxPrev.Image = null;
                    pictureBoxNext.Image = null;
                }
            }
            else
            {
                MessageBox.Show("Папка не найдена: " + path);
            }
        }

        private void ShowPhoto(int index)
        {
            if (index < 0 || index >= currentPhotos.Count) return;

            // Центральное фото
            pictureBoxMain.Image?.Dispose();
            pictureBoxMain.Image = Image.FromFile(currentPhotos[index]);
            pictureBoxMain.SizeMode = PictureBoxSizeMode.Zoom;

            // Предыдущее (уменьшенное)
            int prev = index - 1;
            if (prev >= 0)
            {
                pictureBoxPrev.Image?.Dispose();
                pictureBoxPrev.Image = Image.FromFile(currentPhotos[prev]);
                pictureBoxPrev.SizeMode = PictureBoxSizeMode.Zoom;
                pictureBoxPrev.Visible = true;
            }
            else
            {
                pictureBoxPrev.Image = null;
                pictureBoxPrev.Visible = false;
            }

            // Следующее (уменьшенное)
            int next = index + 1;
            if (next < currentPhotos.Count)
            {
                pictureBoxNext.Image?.Dispose();
                pictureBoxNext.Image = Image.FromFile(currentPhotos[next]);
                pictureBoxNext.SizeMode = PictureBoxSizeMode.Zoom;
                pictureBoxNext.Visible = true;
            }
            else
            {
                pictureBoxNext.Image = null;
                pictureBoxNext.Visible = false;
            }
        }

        private void ButtonPrev_Click(object sender, EventArgs e)
        {
            if (currentIndex > 0)
            {
                currentIndex--;
                ShowPhoto(currentIndex);
            }
        }

        private void ButtonNext_Click(object sender, EventArgs e)
        {
            if (currentIndex < currentPhotos.Count - 1)
            {
                currentIndex++;
                ShowPhoto(currentIndex);
            }
        }

        private void PictureBoxPrev_Click(object sender, EventArgs e)
        {
            if (currentIndex > 0)
            {
                currentIndex--;
                ShowPhoto(currentIndex);
            }
        }

        private void PictureBoxNext_Click(object sender, EventArgs e)
        {
            if (currentIndex < currentPhotos.Count - 1)
            {
                currentIndex++;
                ShowPhoto(currentIndex);
            }
        }

        // Освобождаем ресурсы при закрытии
        private void Form1_FormClosing(object sender, FormClosingEventArgs e)
        {
            pictureBox1.Image?.Dispose();
            pictureBox2.Image?.Dispose();
            pictureBoxMain.Image?.Dispose();
            pictureBoxPrev.Image?.Dispose();
            pictureBoxNext.Image?.Dispose();
        }
    }

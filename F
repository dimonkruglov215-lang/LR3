using System;
using System.Windows.Forms;

namespace DvizhenieFigur
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        // Кнопка "Пуск" для картинки
        private void buttonStart_Click(object sender, EventArgs e)
        {
            timer1.Enabled = true;
            timer1.Interval = 10;
        }

        // Кнопка "Стоп" для картинки
        private void buttonStop_Click(object sender, EventArgs e)
        {
            timer1.Enabled = false;
        }

        // Таймер для движения картинки
        private void timer1_Tick(object sender, EventArgs e)
        {
            // Если картинка доходит до правого края - возвращаем в начало
            if (pictureBox1.Left >= this.ClientSize.Width - pictureBox1.Width)
            {
                pictureBox1.Left = 16;
            }
            else
            {
                pictureBox1.Left = pictureBox1.Left + 1;
            }
        }

        // Кнопка "Двигатель кругов"
        private void buttonCirclesStart_Click(object sender, EventArgs e)
        {
            timer2.Enabled = true;
            timer2.Interval = 10;
        }

        // Кнопка "Остановить круги"
        private void buttonCirclesStop_Click(object sender, EventArgs e)
        {
            timer2.Enabled = false;
        }

        // Кнопка "Восстановить круги"
        private void buttonCirclesReset_Click(object sender, EventArgs e)
        {
            // Возвращаем все круги в центр (координаты 184, 112)
            shape1.Left = 184;
            shape1.Top = 112;
            shape2.Left = 184;
            shape2.Top = 112;
            shape3.Left = 184;
            shape3.Top = 112;
            shape4.Left = 184;
            shape4.Top = 112;
            shape5.Left = 184;
            shape5.Top = 112;
            shape6.Left = 184;
            shape6.Top = 112;
            shape7.Left = 184;
            shape7.Top = 112;
            shape8.Left = 184;
            shape8.Top = 112;
        }

        // Таймер для движения кругов
        private void timer2_Tick(object sender, EventArgs e)
        {
            // 4 круга двигаются прямо
            shape1.Left = shape1.Left + 1;        // вправо
            shape2.Top = shape2.Top + 1;          // вниз
            shape3.Left = shape3.Left - 1;        // влево
            shape4.Top = shape4.Top - 1;          // вверх

            // 4 круга двигаются по диагонали
            shape5.Left = shape5.Left + 1;        // вправо-вниз
            shape5.Top = shape5.Top + 1;
            shape6.Left = shape6.Left - 1;        // влево-вниз
            shape6.Top = shape6.Top + 1;
            shape7.Left = shape7.Left - 1;        // влево-вверх
            shape7.Top = shape7.Top - 1;
            shape8.Left = shape8.Left + 1;        // вправо-вверх
            shape8.Top = shape8.Top - 1;
        }
    }
}

